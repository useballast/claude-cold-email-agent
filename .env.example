# Anthropic Claude API Key (get one at https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-api03-...

# Claude Model to use:
# claude-3-5-sonnet-20241022 (highest intelligence, complex research)
# claude-3-5-haiku-20241022 (ultra-fast, budget friendly for high volume)
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Ballast API Key (create one at https://ballast.to/dashboard -> Settings -> API Keys)
BALLAST_API_KEY=blst_live_...

# Ballast Remote MCP Endpoint (defaults to https://ballast.to/api/mcp)
BALLAST_MCP_URL=https://ballast.to/api/mcp

# Optional sender / offer configuration
SENDER_NAME=Alex
SENDER_COMPANY=Ballast
OFFER_SUMMARY="Cold email software built for modern teams and AI agents: $19/mo for 20,000 emails with unlimited mailboxes and native MCP."
CALENDAR_LINK=https://cal.com/alex/15min
